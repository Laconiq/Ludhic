---
import '@/styles/global.css';
import { SITE_URL } from '@/constants/site';
import type { OgImage } from '@/lib/ogImage';
import { HOME_PATH, absoluteUrl } from '@/lib/urls';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  canonical?: string;
  ogImage?: OgImage;
  ogType?: 'website' | 'article';
  noIndex?: boolean;
}

const DEFAULT_TITLE = 'Ludhic - Portfolio Jeux Étudiants Master HIC | Association Jeux Vidéo';
// Google tronque au-delà d'environ 155 caractères.
const DEFAULT_DESCRIPTION =
  "Les jeux vidéo créés par les étudiants du Master Humanités et Industries Créatives (HIC, ex-MAJIC) : le portfolio de l'association Ludhic.";

// Logo carré : affiché en petite vignette (carte `summary`), pas en bannière.
const DEFAULT_OG_IMAGE: OgImage = { src: '/images/logo.png', width: 1024, height: 1024, alt: 'Logo de Ludhic' };

const {
  title,
  description = DEFAULT_DESCRIPTION,
  keywords = [],
  canonical = absoluteUrl(HOME_PATH),
  ogImage = DEFAULT_OG_IMAGE,
  ogType = 'website',
  noIndex = false,
} = Astro.props;

const fullTitle = title ? `${title} | Ludhic - Master HIC` : DEFAULT_TITLE;
const ogImageUrl = ogImage.src.startsWith('http') ? ogImage.src : `${SITE_URL}${ogImage.src}`;
const twitterCard = ogImage.width / ogImage.height >= 1.5 ? 'summary_large_image' : 'summary';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Les polices ne sont découvertes qu'après le CSS qui les déclare
        (HTML → CSS → police) ; Plus Jakarta Sans est en `font-display:
        optional`, donc le texte reste invisible tant qu'elle n'est pas là.
        Les précharger les fait partir en parallèle du CSS. PixelifySans
        SemiBold est la seule graisse utilisée par `.font-gaming`. */}
    <link rel="preload" href="/fonts/PlusJakartaSans-VariableFont_wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/PixelifySans-SemiBold.woff2" as="font" type="font/woff2" crossorigin />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="author" content="Association Ludhic" />
    {!noIndex && <link rel="canonical" href={canonical} />}

    {/* Googlebot lit sa propre balise en priorité sur `robots` : elle doit
        porter le noindex elle aussi, sinon la 404 restait indexable. */}
    <meta name="robots" content={noIndex ? 'noindex, follow' : 'index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1'} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Ludhic - Association Master HIC" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImage.alt} />

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImage.alt} />

    <meta name="theme-color" content="#06b6d4" />
    <meta name="color-scheme" content="dark" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Ludhic" />
    <meta name="application-name" content="Ludhic" />
    <meta name="msapplication-TileColor" content="#06b6d4" />
    <meta name="msapplication-config" content="/browserconfig.xml" />

    <link rel="icon" href="/images/logo-120x120.png" sizes="120x120" type="image/png" />
    <link rel="icon" href="/images/logo-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/images/logo-16x16.png" sizes="16x16" type="image/png" />
    <link rel="shortcut icon" href="/images/logo-32x32.png" />
    <link rel="apple-touch-icon" href="/images/logo-180x180.png" sizes="180x180" />
    <link rel="apple-touch-icon" href="/images/logo-152x152.png" sizes="152x152" />
    <link rel="apple-touch-icon" href="/images/logo-120x120.png" sizes="120x120" />
    <link rel="manifest" href="/manifest.json" />
  </head>
  <body class="bg-[var(--bg-primary)] text-[var(--text-primary)] antialiased">
    <slot />
  </body>
</html>
