---
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navigation from '@/components/Navigation';
import Footer from '@/components/Footer';
import GameCard from '@/components/GameCard.astro';
import JsonLd from '@/components/JsonLd.astro';
import gamesData from '@/data/games.json';
import { createSlug } from '@/lib/slug';
import { getMainImageUrl, getLogoUrl } from '@/lib/images';
import { resolveGameImage } from '@/lib/assetImages';
import { SITE_URL } from '@/constants/site';
import type { GameData } from '@/types/game';

function getGamesOfYear(year: number) {
  return (gamesData as GameData[]).filter((game) => game.year === year);
}

export async function getStaticPaths() {
  const years = Array.from(new Set((gamesData as GameData[]).map((game) => game.year)));
  return years.map((year) => ({ params: { year: year.toString() } }));
}

const { year: yearParam } = Astro.params;
const year = parseInt(yearParam!, 10);
const gamesOfYear = getGamesOfYear(year);

const logo = await import('@/assets/images/logo.png');
const navLogo = await getImage({ src: logo.default, width: 40, height: 40 });

const backgroundImages = await Promise.all(
  gamesOfYear.map((game) => getImage({ src: resolveGameImage(getMainImageUrl(game.contentFolder)), width: 320, quality: 50, format: 'webp' }))
);
// Hauteur seule : la contrainte CSS dominante (h-12 / md:h-20) est la
// hauteur ; forcer les deux dimensions distordrait les logos dont le ratio
// source ne colle pas à 100:40 (cf. GameHero pour le même correctif).
const logoImages = await Promise.all(
  gamesOfYear.map((game) => getImage({ src: resolveGameImage(getLogoUrl(game.contentFolder)), height: 80, format: 'webp' }))
);

const allGenres = [...new Set(gamesOfYear.flatMap((g) => g.genres))];
const description = `Découvrez les ${gamesOfYear.length} jeux vidéo créés par les étudiants du Master HIC en ${year}. Projets étudiants en ${allGenres.slice(0, 3).join(', ')}.`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Jeux', item: `${SITE_URL}/games` },
    { '@type': 'ListItem', position: 3, name: `${year}`, item: `${SITE_URL}/games/year/${year}` },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Jeux étudiants ${year}`,
  numberOfItems: gamesOfYear.length,
  itemListElement: gamesOfYear.map((game, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: game.title,
    url: `${SITE_URL}/games/${createSlug(game.title)}`,
  })),
};
---

<BaseLayout
  title={`Jeux étudiants ${year}`}
  description={description}
  keywords={[`jeux ${year}`, ...allGenres, 'Master HIC', 'jeux étudiants', 'Ludhic', 'projets étudiants']}
  canonical={`${SITE_URL}/games/year/${year}`}
  ogImage={backgroundImages[0]?.src}
  ogType="article"
>
  <JsonLd schema={[breadcrumbSchema, itemListSchema]} />
  <div class="min-h-screen bg-[var(--bg-primary)] flex flex-col">
    <Navigation client:load logoSrc={navLogo.src} />
    <section class="relative w-full py-16 md:py-24 bg-[var(--bg-primary)] mb-0 overflow-hidden">
      <div class="absolute inset-0 w-full h-full flex">
        {gamesOfYear.map((_game, index) => (
          <div class="relative flex-1 h-full min-w-0">
            <img
              src={backgroundImages[index].src}
              alt=""
              aria-hidden="true"
              class="absolute inset-0 object-cover w-full h-full blur-sm opacity-70"
              loading={index === 0 ? 'eager' : 'lazy'}
            />
          </div>
        ))}
        <div class="absolute inset-0 bg-black/60" />
      </div>
      <div class="relative z-10 max-w-4xl mx-auto text-center px-4">
        <h1 class="text-3xl md:text-5xl font-gaming foil-effect mb-6">JEUX ÉTUDIANTS {year}</h1>
        <p class="text-white/80 text-lg md:text-xl max-w-2xl mx-auto mb-8 font-gaming">
          Découvrez les créations interactives des étudiants du Master HIC pour l'année {year}.
        </p>
        <div class="flex flex-wrap justify-center items-center gap-4 md:gap-8">
          {gamesOfYear.map((game, index) => (
            <div class="bg-black/40 rounded-xl p-2 md:p-3 flex items-center justify-center shadow-lg">
              <img
                src={logoImages[index].src}
                alt={game.title + ' Logo'}
                class="h-12 w-auto md:h-20 object-contain drop-shadow-xl"
                style="max-width: 120px"
              />
            </div>
          ))}
        </div>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 pb-16 pt-12 w-full">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 auto-rows-fr">
        {gamesOfYear.map((game, index) => (
          <GameCard game={game} priority={index < 4} />
        ))}
      </div>
    </div>
    <Footer client:visible />
  </div>
</BaseLayout>
