---
import type { JsonLdSchema } from '@/types/game';

interface Props {
  schema: JsonLdSchema | JsonLdSchema[];
}

const { schema } = Astro.props;
const schemas = Array.isArray(schema) ? schema : [schema];
---

{schemas.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} is:inline />
))}
