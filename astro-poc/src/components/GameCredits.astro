---
import type { Credit } from '@/types/game';

interface Props {
  credits: Credit[];
}

const { credits } = Astro.props;
---

<div class="mb-16">
  <h3 class="text-lg font-gaming text-cyan-400 mb-8 tracking-wider">
    ÉQUIPE DE DÉVELOPPEMENT
  </h3>
  <div class="bg-[var(--bg-tertiary)]/30 backdrop-blur-sm rounded-lg p-6 border border-[var(--border-primary)]">
    {credits.map((member) => (
      <div class="flex flex-wrap items-baseline gap-2 mb-2">
        <span class="font-semibold text-white text-sm md:text-base">
          {member.firstName} {member.lastName}
        </span>
        <span class="text-cyan-300 text-xs md:text-sm">
          {member.roles.length > 0 ? member.roles.join(', ') : 'Contributeur'}
        </span>
      </div>
    ))}
  </div>
</div>
