---
import GameCard from '@/components/GameCard.astro';
import type { GameData } from '@/types/game';

interface Props {
  games: GameData[];
}

const { games } = Astro.props;
---

{games.length > 0 && (
  <section class="py-16 px-4 bg-[var(--bg-primary)] border-t border-[var(--border-primary)]">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-gaming foil-effect text-center mb-10">
        JEUX SIMILAIRES
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 auto-rows-fr">
        {games.map((game) => (
          <GameCard game={game} />
        ))}
      </div>
    </div>
  </section>
)}
